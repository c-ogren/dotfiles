{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // "logo": {
  //   "type": "builtin",
  //   "source": "arch_small",
  //   "padding": {
  //     "right": 3,
  //     "bottom": 1,
  //     "top": 1
  //   },
  //   "color": {
  //     "1": "blue"
  //   }
  // },
  //

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo2.txt",
    "padding": {
      "right": 4,
      "bottom": 1,
      "top": 1,
      "left": 1
    },
    "color": {
      "1": "#1f6feb",
      "2": "#58a6ff",
      "3": "#79c0ff",
      "4": "#e3b341"
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{##58a6ff}{user-name}{#}{#dim_white}@{#}{##79c0ff}{host-name}{#}"
    },

    "break",

    {
      "type": "os",
      "key": "󰣇  OS"
    },
    {
      "type": "kernel",
      "key": "󰒋  Kernel"
    },
    {
      "type": "wm",
      "key": "  WM"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },

    // {
    //   "type": "cpu",
    //   "key": "  CPU"
    // },
    // {
    //   "type": "gpu",
    //   "key": "󰢮  GPU"
    // },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk"
    },

    {
      "type": "uptime",
      "key": "󰅐  Uptime"
    },

    "break",

    "colors"
  ]
}
