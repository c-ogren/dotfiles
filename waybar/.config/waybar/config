{
  "layer": "top",
  "position": "bottom",
  "tooltip": true,

  "modules-left": [
    "ext/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "mpris",
    "clock"
  ],

  "modules-right": [
    "power-profiles-daemon",
    "cpu",
    "temperature",
    "memory",
    "load",
    "custom/uptime",
    "privacy",
    "disk",
    "network",
    "pulseaudio",
    "bluetooth",
    "battery",
    "tray"
  ],

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "mpris": {
    "format": "  {artist} - {title}",
    "format-paused": "  {artist} - {title}",
    "max-length": 35
  },

  "clock": {
    "interval": 1,
    "format": "  {:%a, %b %d %H:%M}",
    "tooltip-format": "<big><b>  {:%H:%M:%S}</b></big>\n\n<tt>{calendar}</tt>",

    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span background='#539BF5' color='#0d1117'><b> {} </b></span>"
      }
    }
  },

  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}\n{num_connections} connected"
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip-format": "Usage: {usage}%\nFrequency: {avg_frequency:.1f} GHz\nLoad: {load1}"
  },

  "memory": {
    "format": "  {used}G / {total}G"
  },
  
  "disk": {
    "format": "  {used}/{total}",
    "path": "/"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  eth",
    "format-disconnected": "󰤭  off",

    "tooltip-format-wifi":
      "{essid}\n{ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",

    "tooltip-format-ethernet":
      "{ifname}\n{ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "  {temperatureC}°C",
    "critical-threshold": 85
  },

  "privacy": {
    "icon-spacing": 6,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      }
    ]
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "tooltip-format": "Volume: {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t"
  },

  "battery": {
    "format": "  {capacity}%",
    "format-charging": " {capacity}%"
  },

  "custom/uptime": {
    "exec": "uptime -p | sed 's/up //'",
    "interval": 60,
    "format": "󰔟  {}",
    "tooltip": false
  },

  "load": {
    "format": "  {load1}",
    "tooltip-format": "1 min: {load1}\n5 min: {load5}\n15 min: {load15}"
  },

  // Not hyprland/workspaces: waybar 0.15 switches workspace with the legacy
  // `dispatch workspace N`, which Hyprland's Lua config rejects.
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40
  }
}
